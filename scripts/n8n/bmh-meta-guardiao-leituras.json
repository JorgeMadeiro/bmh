{
  "_leia": "Leituras do guardião do Meta da BMH (20/10/2026). O montador faz um nó HTTP por linha (credencial BMH · Meta Instagram (token)); o testa-guardiao-meta.js faz as mesmas pelo cofre (rota meta-bmh). {nome} é trocado pelo valor do nó Quando. Só GET; nada de lead, conversa ou mensagem.",
  "versao": "v26.0",
  "conta": "act_327952129944258",
  "leituras": [
    { "no": "Meta · conta", "chave": "conta", "caminho": "{conta}", "consulta": { "fields": "account_status,disable_reason,spend_cap,amount_spent,balance,is_prepay_account,funding_source_details" } },
    { "no": "Meta · campanhas", "chave": "campanhas", "caminho": "{conta}/campaigns", "consulta": { "fields": "id,name,effective_status,daily_budget", "limit": "200" } },
    { "no": "Meta · conjuntos", "chave": "conjuntos", "caminho": "{conta}/adsets", "consulta": { "fields": "id,name,campaign_id,effective_status,daily_budget,optimization_goal,destination_type,created_time", "limit": "200" } },
    { "no": "Meta · anúncios", "chave": "anuncios", "caminho": "{conta}/ads", "consulta": { "fields": "id,name,adset_id,effective_status", "limit": "500" } },
    { "no": "Meta · ontem por conjunto", "chave": "ontemConj", "caminho": "{conta}/insights", "consulta": { "level": "adset", "date_preset": "yesterday", "fields": "adset_id,adset_name,spend,impressions", "limit": "200" } },
    { "no": "Meta · 3 dias por conjunto", "chave": "tresConj", "caminho": "{conta}/insights", "consulta": { "level": "adset", "date_preset": "last_3d", "fields": "adset_id,spend,actions", "limit": "200" } },
    { "no": "Meta · 7 dias por conjunto", "chave": "seteConj", "caminho": "{conta}/insights", "consulta": { "level": "adset", "date_preset": "last_7d", "fields": "adset_id,adset_name,spend,reach,frequency", "limit": "200" } },
    { "no": "Meta · 7 dias da conta", "chave": "dias7", "caminho": "{conta}/insights", "consulta": { "date_preset": "last_7d", "time_increment": "1", "fields": "date_start,spend", "limit": "10" } },
    { "no": "Meta · mês até ontem", "chave": "mes", "caminho": "{conta}/insights", "consulta": { "time_range": "{\"since\":\"{mes_desde}\",\"until\":\"{ontem}\"}", "fields": "spend" } },
    { "no": "Meta · alterações de ontem", "chave": "alteracoes", "caminho": "{conta}/activities", "consulta": { "since": "{ontem}", "until": "{hoje}", "fields": "event_time,event_type,translated_event_type,actor_name,object_name", "limit": "200" } }
  ]
